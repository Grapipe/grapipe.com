---
import { T, homePath, blogBase, type Lang } from "../lib/site";

interface Props { lang: Lang; onHome: boolean; switchHref: string; showBlog: boolean }
const { lang, onHome, switchHref, showBlog } = Astro.props;
const t = T[lang];
const home = homePath(lang);
const a = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
const other = lang === "en" ? "ko" : "en";
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={home} aria-label={t.home}>
      <img src="/assets/logo/grapipe-horizontal-color.svg" alt="Grapipe" width="146" height="37">
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">{t.menuOpen}</span>
      <span class="bar"></span><span class="bar"></span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label={t.mainMenu}>
      <a href={a("services")}>{t.nav.services}</a>
      <a href={a("process")}>{t.nav.process}</a>
      <a href={a("principles")}>{t.nav.principles}</a>
      <a href={a("faq")}>{t.nav.faq}</a>
      {showBlog && <a href={blogBase(lang)}>{t.nav.blog}</a>}
      <a class="lang-switch" href={switchHref} hreflang={other} lang={other} data-set-lang={other}>{t.switchLabel}</a>
      <a class="nav-cta" href={a("contact")}>{t.contact}</a>
    </nav>
  </div>
</header>
