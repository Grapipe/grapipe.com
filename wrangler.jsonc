{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grapipe-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "grapipe.com", "custom_domain": true },
    { "pattern": "www.grapipe.com", "custom_domain": true }
  ],
  "workers_dev": false
}
